# Environment
NODE_ENV=development

# Database
# For local development, use your local PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cradlemrx_dev?schema=public"

# Server
PORT=5050
TRUST_PROXY=false

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX_REQUESTS=20

# Reddit upstream pacing
REDDIT_MIN_REQUEST_INTERVAL_MS=800
